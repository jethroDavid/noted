# Dependencies
node_modules/
.pnpm-store/

# Build outputs
.next/
next-env.d.ts
cdk.out/
dist/
coverage/
*.tsbuildinfo
.turbo/
.cache/

# Env and secrets (never commit; Phase 0 adds .env.example)
.env
.env.*
!.env.example

# Local-only state (Firebase creds, scratch)
.local/

# Demo/test uploads (visible working-tree folder, never committed)
test-media/

# Test and review artifacts
test-results/
playwright-report/
.screenshots/

# Capacitor Android (generated native project shell is committed; local SDK
# state and build outputs are not)
apps/mobile/android/.gradle/
apps/mobile/android/.idea/
apps/mobile/android/app/build/
apps/mobile/android/build/
apps/mobile/android/capacitor-cordova-android-plugins/
apps/mobile/android/local.properties
apps/mobile/android/*.iml
# Fully regenerated by `cap sync` (copied web assets + derived config)
apps/mobile/android/app/src/main/assets/

# Electron installer output (unsigned NSIS builds, regenerated on demand)
apps/desktop/release/

# OS and editor
.DS_Store
*.pem
