# Local-only development values. Copy this file to .env with `pnpm local:setup`.
POSTGRES_DB=noted
POSTGRES_USER=noted
POSTGRES_PASSWORD=noted_local_only
POSTGRES_PORT=55432
DATABASE_URL=postgresql://noted:noted_local_only@127.0.0.1:55432/noted
DATABASE_POOL_MAX=5

