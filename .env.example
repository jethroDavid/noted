# Local development values. Copy this file to .env with `pnpm local:setup`.
POSTGRES_DB=noted
POSTGRES_USER=noted
POSTGRES_PASSWORD=noted_local_only
POSTGRES_PORT=55432
DATABASE_URL=postgresql://noted:noted_local_only@127.0.0.1:55432/noted
DATABASE_POOL_MAX=5

# Phase 4: fill these from a real Firebase web app after enabling Google sign-in.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=
# Store the service-account JSON under ignored .local/ and set its absolute path.
GOOGLE_APPLICATION_CREDENTIALS=

LOCAL_UPLOAD_DIR=../../.local/uploads
