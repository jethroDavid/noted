# Local Postgres (see compose.yaml)
DATABASE_URL=postgresql://noted:noted@localhost:5434/noted

# Local Redis (see compose.yaml); in production this is the Upstash
# Redis TLS endpoint (rediss://default:<token>@<host>:6379)
REDIS_URL=redis://localhost:6380

# Firebase Admin (server-only): service-account JSON on one line
FIREBASE_SERVICE_ACCOUNT_KEY_INLINE={"type":"service_account","project_id":"demo","private_key":"...","client_email":"..."}

# Firebase web config (embedded in the client bundle)
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app-id

PORT=3000
