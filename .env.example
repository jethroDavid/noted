# Local Postgres (see compose.yaml)
DATABASE_URL=postgresql://noted:noted@localhost:5434/noted

# Optional separate credentials for automated production migrations.
# Otherwise the Vercel release reuses DATABASE_URL and converts Neon's
# pooled hostname to the corresponding direct hostname for session locks.
# MIGRATION_DATABASE_URL=

# Native database synchronization. Configure the PowerSync instance with
# powersync/sync-config.yaml and the Firebase project before setting this.
# POWERSYNC_URL=https://your-instance.powersync.journeyapps.com
# Local-only integration tests create and remove a temporary test database.
# NOTED_SYNC_TEST_DATABASE_URL=postgresql://noted:noted@localhost:5434/noted_sync_test

# Local Redis (see compose.yaml); in production this is the Upstash
# Redis TLS endpoint (rediss://default:<token>@<host>:6379)
REDIS_URL=redis://localhost:6380

# S3-compatible object storage (see compose.yaml for local MinIO;
# managed S3 in production)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=noted-media
S3_ACCESS_KEY_ID=noted
S3_SECRET_ACCESS_KEY=notednoted

# Upstash QStash (unset locally: the dev server signs and delivers to
# local routes; production wiring lands in Phase 4)
# QSTASH_TOKEN=
# QSTASH_CURRENT_SIGNING_KEY=
# QSTASH_NEXT_SIGNING_KEY=

# Worker base URL: the production app URL for QStash callbacks (Phase 4).
# The dev server delivers local jobs to WORKER_BASE_URL
# (default http://localhost:$PORT).
# APP_URL=
# WORKER_BASE_URL=

# Firebase Admin (server-only): service-account JSON on one line
FIREBASE_SERVICE_ACCOUNT_KEY_INLINE={"type":"service_account","project_id":"demo","private_key":"...","client_email":"..."}

# Firebase web config (embedded in the client bundle)
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app-id

PORT=3000
