{
  "name": "@noted/db",
  "private": true,
  "type": "module",
  "exports": {
    "./src": "./src/index.ts"
  },
  "scripts": {
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "generate": "node --conditions=react-server ./node_modules/drizzle-kit/bin.cjs generate",
    "migrate": "dotenv -e ../../.env -- node --conditions=react-server --import tsx src/migrate.ts",
    "migrate:deploy": "node --conditions=react-server --import tsx src/migrate.ts",
    "seed": "dotenv -e ../../.env -- node --conditions=react-server --import tsx src/seed.ts"
  },
  "devDependencies": {
    "@noted/eslint-config": "workspace:*",
    "@noted/prettier-config": "workspace:*",
    "@noted/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "^5.0.1"
  },
  "prettier": "@noted/prettier-config",
  "dependencies": {
    "drizzle-orm": "catalog:",
    "pg": "^8.23.0",
    "server-only": "catalog:"
  }
}
